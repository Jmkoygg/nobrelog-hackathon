# Copie para .env e preencha com os valores do projeto Supabase
# (Project Settings > API no painel do Supabase).

# URL do projeto, ex.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# anon/public key — usada pelo frontend e como fallback de leitura publica.
SUPABASE_ANON_KEY=

# service_role key — NUNCA vai para o frontend. Usada apenas pelo backend
# para operacoes administrativas pontuais (ex.: bootstrap de dados de teste).
# Se nao for fornecida, o backend continua funcionando para os fluxos
# autenticados normais (que usam o token do proprio usuario).
SUPABASE_SERVICE_ROLE_KEY=

# Ativa validacao de JWT via JWKS (recomendado, projetos novos do Supabase).
SUPABASE_JWKS_URL=${SUPABASE_URL}/auth/v1/.well-known/jwks.json

# Fallback legado: alguns projetos Supabase mais antigos assinam o JWT com
# HS256 e um segredo compartilhado em vez de JWKS. Preencha SOMENTE se a
# verificacao via JWKS falhar (Project Settings > API > JWT Settings).
SUPABASE_JWT_SECRET=

CORS_ALLOW_ORIGINS=http://localhost:5173
